<Window x:Class="SiKasir.Views.Auth.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SI-KASIR - Login" Width="460" Height="560"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}">
    <Grid>
        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="14"
                BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1"
                Margin="30" Padding="32">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="SI-KASIR" FontSize="30" FontWeight="Bold"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Masuk untuk melanjutkan" Foreground="{StaticResource MutedTextBrush}"
                           HorizontalAlignment="Center" Margin="0,4,0,28"/>

                <TextBlock Text="Username" Margin="0,0,0,6"/>
                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Password" Margin="0,16,0,6"/>
                <PasswordBox x:Name="PasswordInput"/>

                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}"
                           TextWrapping="Wrap" Margin="0,12,0,0" MinHeight="20"/>

                <Button Content="Masuk" Style="{StaticResource PrimaryButton}" Margin="0,16,0,0"
                        Command="{Binding LoginCommand}"
                        CommandParameter="{Binding ElementName=PasswordInput}"
                        IsDefault="True"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>