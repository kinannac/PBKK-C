<UserControl x:Class="SiKasir.Views.Kasir.DashboardKasirView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Dashboard Kasir" FontSize="26" FontWeight="Bold"/>
        <TextBlock Text="Ringkasan transaksi Anda hari ini" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,24"/>

        <UniformGrid Columns="2">
            <Border Style="{StaticResource CardBorder}" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Total Transaksi Hari Ini" Foreground="{StaticResource MutedTextBrush}"/>
                    <TextBlock Text="{Binding TotalTransaksi}" FontSize="36" FontWeight="Bold" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}" Margin="10,0,0,0">
                <StackPanel>
                    <TextBlock Text="Total Barang Terjual" Foreground="{StaticResource MutedTextBrush}"/>
                    <TextBlock Text="{Binding TotalBarang}" FontSize="36" FontWeight="Bold" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Button Content="MENU KASIR (POS)" Style="{StaticResource PrimaryButton}"
                FontSize="20" Padding="20,28" Margin="0,24,0,0"
                Command="{Binding OpenPosCommand}"/>

        <TextBlock Text="{Binding Message}" Foreground="{StaticResource MutedTextBrush}" Margin="0,12,0,0"/>
    </StackPanel>
</UserControl>