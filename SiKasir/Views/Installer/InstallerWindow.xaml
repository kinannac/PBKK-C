<Window x:Class="SiKasir.Views.Installer.InstallerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:h="clr-namespace:SiKasir.Helpers"
        Title="Instalasi SI-KASIR" Width="680" Height="640" MinHeight="560"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize"
        Background="{StaticResource BackgroundBrush}">
    <Window.Resources>
        <h:StepVisibilityConverter x:Key="StepVis"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
        <Style x:Key="MessageText" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
            <Setter Property="MinHeight" Value="20"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsError}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Style="{StaticResource CardBorder}" Margin="24" Padding="28">
        <DockPanel>
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,18">
                <TextBlock Text="Instalasi SI-KASIR" FontSize="24" FontWeight="Bold"/>
                <TextBlock Text="{Binding StepInfo}" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                <TextBlock Text="{Binding Message}" Style="{StaticResource MessageText}" Margin="0,0,0,10"/>
                <Grid Visibility="{Binding ShowNav, Converter={StaticResource BoolToVis}}">
                    <Button Content="Kembali" Style="{StaticResource SidebarButton}" HorizontalAlignment="Left"
                            Visibility="{Binding ShowBack, Converter={StaticResource BoolToVis}}"
                            Command="{Binding BackCommand}"/>
                    <Button Content="{Binding NextText}" Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Right" MinWidth="160" Command="{Binding NextCommand}"/>
                </Grid>
                <Button Content="Masuk ke SI-KASIR" Style="{StaticResource PrimaryButton}"
                        Visibility="{Binding ShowFinish, Converter={StaticResource BoolToVis}}"
                        Command="{Binding FinishCommand}"/>
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid>
                    <!-- 0: Selamat datang -->
                    <StackPanel Visibility="{Binding Step, Converter={StaticResource StepVis}, ConverterParameter=0}">
                        <TextBlock Text="Selamat datang di SI-KASIR" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,10,0,0" Foreground="{StaticResource MutedTextBrush}"
                                   Text="Installer ini akan menyiapkan aplikasi kasir Anda. Langkah-langkahnya:"/>
                        <TextBlock Margin="0,14,0,0" LineHeight="26"
                                   Text="1. Mengatur server dan port SQL Server&#x0A;2. Menghubungkan dan menyiapkan database&#x0A;3. Membuat akun administrator&#x0A;4. Mengisi profil toko&#x0A;5. Menjalankan instalasi"/>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,16,0,0"
                                   Text="Pastikan SQL Server sudah terpasang dan berjalan sebelum melanjutkan."/>
                    </StackPanel>

                    <!-- 1: Jaringan dan port -->
                    <StackPanel Visibility="{Binding Step, Converter={StaticResource StepVis}, ConverterParameter=1}">
                        <TextBlock Text="Alamat server SQL Server"/>
                        <TextBox Text="{Binding Server, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0"/>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Contoh: .\SQLEXPRESS untuk SQL Server di komputer ini, atau alamat IP server."/>

                        <TextBlock Text="Port (opsional)" Margin="0,14,0,0"/>
                        <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0" Width="160" HorizontalAlignment="Left"/>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Kosongkan untuk port bawaan (1433). Port diabaikan jika server memakai nama instance seperti .\SQLEXPRESS."/>

                        <CheckBox Content="Gunakan Windows Authentication" Margin="0,18,0,0"
                                  Foreground="{StaticResource TextBrush}" IsChecked="{Binding WindowsAuth}"/>

                        <StackPanel IsEnabled="{Binding UseSqlAuth}" Margin="0,8,0,0">
                            <TextBlock Text="Username SQL Server" Margin="0,6,0,0"/>
                            <TextBox Text="{Binding DbUser, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0"/>
                            <TextBlock Text="Password SQL Server" Margin="0,14,0,0"/>
                            <PasswordBox Margin="0,6,0,0" PasswordChanged="DbPassword_Changed"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- 2: Koneksi database -->
                    <StackPanel Visibility="{Binding Step, Converter={StaticResource StepVis}, ConverterParameter=2}">
                        <TextBlock Text="Nama database"/>
                        <TextBox Text="{Binding Database, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0"/>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Database dibuat otomatis jika belum ada. Gunakan nama baru agar data lama tidak tercampur."/>
                        <Button Content="Tes koneksi" Style="{StaticResource PrimaryButton}" Margin="0,18,0,0"
                                HorizontalAlignment="Left" MinWidth="160" Command="{Binding TestCommand}"/>
                        <TextBlock Style="{StaticResource Hint}" Text="Tes koneksi harus berhasil sebelum Anda bisa melanjutkan."/>
                    </StackPanel>

                    <!-- 3: Akun administrator -->
                    <StackPanel Visibility="{Binding Step, Converter={StaticResource StepVis}, ConverterParameter=3}">
                        <TextBlock Text="Nama lengkap"/>
                        <TextBox Text="{Binding AdminNama, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0"/>
                        <TextBlock Text="Username" Margin="0,14,0,0"/>
                        <TextBox Text="{Binding AdminUser, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0"/>
                        <TextBlock Text="Password" Margin="0,14,0,0"/>
                        <PasswordBox Margin="0,6,0,0" PasswordChanged="AdminPass_Changed"/>
                        <TextBlock Text="Konfirmasi password" Margin="0,14,0,0"/>
                        <PasswordBox Margin="0,6,0,0" PasswordChanged="AdminPass2_Changed"/>
                    </StackPanel>

                    <!-- 4: Profil toko -->
                    <StackPanel Visibility="{Binding Step, Converter={StaticResource StepVis}, ConverterParameter=4}">
                        <TextBlock Text="Nama toko"/>
                        <TextBox Text="{Binding NamaToko, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0"/>
                        <TextBlock Text="Alamat (opsional)" Margin="0,14,0,0"/>
                        <TextBox Text="{Binding Alamat, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0"/>
                        <TextBlock Text="Telepon (opsional)" Margin="0,14,0,0"/>
                        <TextBox Text="{Binding Telepon, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0"/>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,16,0,0"
                                   Text="Klik Mulai instalasi untuk membuat database, tabel, akun administrator, dan profil toko."/>
                    </StackPanel>

                    <!-- 5: Selesai -->
                    <StackPanel Visibility="{Binding Step, Converter={StaticResource StepVis}, ConverterParameter=5}">
                        <TextBlock Text="Instalasi berhasil" FontSize="22" FontWeight="Bold"/>
                        <TextBlock Text="SI-KASIR siap digunakan. Berikut ringkasan instalasi:"
                                   Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,16"/>
                        <Border Style="{StaticResource CardBorder}" Background="{StaticResource BackgroundBrush}">
                            <TextBlock Text="{Binding Summary}" LineHeight="24"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>