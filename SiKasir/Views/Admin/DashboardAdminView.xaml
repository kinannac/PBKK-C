<UserControl x:Class="SiKasir.Views.Admin.DashboardAdminView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Grid>
                <StackPanel>
                    <TextBlock Text="Dashboard Admin" FontSize="26" FontWeight="Bold"/>
                    <TextBlock Text="Ringkasan toko bulan ini" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,20"/>
                </StackPanel>
                <Button Content="Muat ulang" Style="{StaticResource SidebarButton}"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Command="{Binding RefreshCommand}"/>
            </Grid>

            <UniformGrid Columns="4">
                <Border Style="{StaticResource CardBorder}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Total Pendapatan" Foreground="{StaticResource MutedTextBrush}"/>
                        <TextBlock Text="{Binding TotalPendapatan}" FontSize="22" FontWeight="Bold" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}" Margin="4,0,4,0">
                    <StackPanel>
                        <TextBlock Text="Total Produk" Foreground="{StaticResource MutedTextBrush}"/>
                        <TextBlock Text="{Binding TotalProduk}" FontSize="22" FontWeight="Bold" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}" Margin="4,0,4,0">
                    <StackPanel>
                        <TextBlock Text="Jumlah Transaksi" Foreground="{StaticResource MutedTextBrush}"/>
                        <TextBlock Text="{Binding JumlahTransaksi}" FontSize="22" FontWeight="Bold" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Total Pelanggan (semua)" Foreground="{StaticResource MutedTextBrush}"/>
                        <TextBlock Text="{Binding TotalPelanggan}" FontSize="22" FontWeight="Bold" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <!-- Grafik 7 hari -->
                <Border Style="{StaticResource CardBorder}" Margin="0,0,8,0" MinHeight="280">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Penjualan 7 Hari Terakhir" FontWeight="SemiBold" FontSize="16"/>
                        <ItemsControl ItemsSource="{Binding Penjualan}" Margin="0,16,0,0" VerticalAlignment="Bottom">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Bottom" Margin="4,0">
                                        <TextBlock Text="{Binding ValueText}" FontSize="11"
                                                   Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center"/>
                                        <Border Height="{Binding BarHeight}" Margin="8,4,8,0"
                                                Background="{StaticResource PrimaryBrush}" CornerRadius="4,4,0,0"/>
                                        <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>

                <!-- Stok menipis -->
                <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="8,0,0,0" MinHeight="280">
                    <StackPanel>
                        <TextBlock Text="Produk Stok Menipis" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,12"/>
                        <TextBlock Text="{Binding StokKosongText}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"/>
                        <ItemsControl ItemsSource="{Binding StokMenipis}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4">
                                        <TextBlock Text="{Binding Nama}"/>
                                        <TextBlock Text="{Binding Stok, StringFormat='Sisa {0}'}"
                                                   Foreground="{StaticResource DangerBrush}" HorizontalAlignment="Right"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Aktivitas -->
            <Border Style="{StaticResource CardBorder}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Aktivitas Kasir Terbaru" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,12"/>
                    <TextBlock Text="{Binding AktivitasKosongText}" Foreground="{StaticResource MutedTextBrush}"/>
                    <ItemsControl ItemsSource="{Binding Aktivitas}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <TextBlock Text="{Binding Teks}" TextTrimming="CharacterEllipsis" Margin="0,0,110,0"/>
                                    <TextBlock Text="{Binding Waktu}" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Right"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding Message}" Foreground="{StaticResource DangerBrush}" Margin="0,12,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>