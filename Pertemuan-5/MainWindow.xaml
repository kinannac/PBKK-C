<Window x:Class="StudentManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Student Management System"
        Width="1200"
        Height="750"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#1565c0"
                CornerRadius="10"
                Padding="20"
                Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="STUDENT MANAGEMENT SYSTEM"
                           Foreground="White"
                           FontSize="28"
                           FontWeight="Bold"/>
                <TextBlock Text="Manage student data"
                           Foreground="White"
                           FontSize="14"
                           Opacity="0.85"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="NIM" FontWeight="SemiBold" Margin="0,5,0,2"/>
                <TextBox Text="{Binding SelectedStudent.NIM, UpdateSourceTrigger=PropertyChanged}" Padding="5" Margin="0,0,0,10"/>

                <TextBlock Text="Nama" FontWeight="SemiBold" Margin="0,5,0,2"/>
                <TextBox Text="{Binding SelectedStudent.Nama, UpdateSourceTrigger=PropertyChanged}" Padding="5" Margin="0,0,0,10"/>

                <TextBlock Text="Jurusan" FontWeight="SemiBold" Margin="0,5,0,2"/>
                <ComboBox SelectedValue="{Binding SelectedStudent.Jurusan}" 
                        SelectedValuePath="Content" 
                        Padding="5" Margin="0,0,0,10">
                    <ComboBoxItem>Informatika</ComboBoxItem>
                    <ComboBoxItem>Sistem Informasi</ComboBoxItem>
                </ComboBox>

                <TextBlock Text="Gender" FontWeight="SemiBold" Margin="0,5,0,2"/>
                <ComboBox SelectedValue="{Binding SelectedStudent.Gender}" 
                        SelectedValuePath="Content" 
                        Padding="5" Margin="0,0,0,10">
                    <ComboBoxItem>Laki-laki</ComboBoxItem>
                    <ComboBoxItem>Perempuan</ComboBoxItem>
                </ComboBox>

                <TextBlock Text="Email" FontWeight="SemiBold" Margin="0,5,0,2"/>
                <TextBox Text="{Binding SelectedStudent.Email, UpdateSourceTrigger=PropertyChanged}" Padding="5" Margin="0,0,0,15"/>

                <StackPanel Orientation="Horizontal">
                    <Button Content="Simpan" Command="{Binding SaveCommand}" Background="#1976D2" Foreground="White" Padding="20,10" Margin="0,0,10,0"/>
                    <Button Content="Delete" Command="{Binding DeleteCommand}" Background="#D32F2F" Foreground="White" Padding="20,10" Margin="0,0,10,0"/>
                    <Button Content="Reset" Command="{Binding ResetCommand}" Padding="20,10"/>
                </StackPanel>
            </StackPanel>

            <Border Grid.Column="2" Background="#F5F5F5" CornerRadius="8" Padding="15">
                <StackPanel>
                    <TextBlock Text="INFORMASI STATISTIK" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Total Mahasiswa" FontSize="14"/>
                            <TextBlock Text="{Binding TotalStudents}" FontSize="28" FontWeight="Bold" Foreground="#1565c0"/>
                        </StackPanel>
                    </Grid>

                    <Separator Margin="0,10,0,10"/>

                    <UniformGrid Columns="2" Rows="2">
                        <StackPanel Margin="0,0,5,10">
                            <TextBlock Text="Informatika" FontSize="12"/>
                            <TextBlock Text="{Binding TotalInformatika}" FontSize="20" FontWeight="Bold"/>
                        </StackPanel>
                        <StackPanel Margin="5,0,0,10">
                            <TextBlock Text="Sistem Informasi" FontSize="12"/>
                            <TextBlock Text="{Binding TotalSistemInformasi}" FontSize="20" FontWeight="Bold"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,5,0">
                            <TextBlock Text="Laki-laki" FontSize="12"/>
                            <TextBlock Text="{Binding TotalLakiLaki}" FontSize="20" FontWeight="Bold"/>
                        </StackPanel>
                        <StackPanel Margin="5,0,0,0">
                            <TextBlock Text="Perempuan" FontSize="12"/>
                            <TextBlock Text="{Binding TotalPerempuan}" FontSize="20" FontWeight="Bold"/>
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="300" Padding="8" Margin="0,0,10,0" VerticalContentAlignment="Center"/>
            <Button Content="Cari" Command="{Binding SearchCommand}" Padding="25,8"/>
        </StackPanel>

        <DataGrid Grid.Row="3"
                  ItemsSource="{Binding Students}"
                  SelectedItem="{Binding SelectedStudent, Mode=TwoWay}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="NIM" Binding="{Binding NIM}" Width="120"/>
                <DataGridTextColumn Header="Nama" Binding="{Binding Nama}" Width="200"/>
                <DataGridTextColumn Header="Jurusan" Binding="{Binding Jurusan}" Width="180"/>
                <DataGridTextColumn Header="Gender" Binding="{Binding Gender}" Width="120"/>
                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>